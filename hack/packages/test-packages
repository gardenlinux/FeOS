#!/bin/bash
# Install the packages (make packages) on Debian 13 with systemd, in a
# privileged container, and check feosd and diskd under systemd: feosd's
# group and socket, a pod from the installed guest and Firecracker on a
# disk from diskd, its cgroup, a
# restart that keeps the pod, the VMs a feosd from before --vms-cgroup
# leaves in its own cgroup handed over, the resolver's sockets in feosd.socket
# across a stop of feosd, the refused self-upgrade, what autoremove
# keeps, a pod's disk across a restart of diskd and a stop, no
# hibernation without an object store, pods on feosd's network (an fd00: prefix and link-local IPv4
# addresses behind proxy ARP and masquerade, DNS, security groups, a
# denied prefix, traffic records, the deletion of a pod's connections,
# the metadata service) and their forwarded services, removal, and a
# power-off through PID 1.
#
#   hack/packages/test-packages
#   TEST_PACKAGES_BASE=debian:sid hack/packages/test-packages
#
# TEST_PACKAGES_BASE is the image the node is made from, debian:13 by
# default: another Debian, such as one with a newer systemd.
#
# Needs docker, /dev/kvm, the ublk driver, and IPv4 internet access for
# the pods' images and checks; IPv6 internet is not needed. The node's
# /dev is the container's, where diskd's devices appear.
set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
PACKAGES_DIR="${REPO_ROOT}/target/packages"
BASE="${TEST_PACKAGES_BASE:-debian:13}"
IMAGE="feos-test-packages-${BASE//[^a-z0-9.]/-}"
# A node of this run's own, so that runs side by side do not remove each
# other's.
NAME="feos-test-packages-$$"
TIMEOUT=60

log() { printf '[test-packages] %s\n' "$*"; }
fail() {
  log "FAIL: $*"
  docker exec "${NAME}" journalctl -u diskd -u feosd --no-pager -n 40 2>/dev/null || true
  docker exec "${NAME}" sh -c 'for c in . system.slice system.slice/feosd.service; do
    echo "$c: controllers $(cat /sys/fs/cgroup/$c/cgroup.controllers), subtree $(cat /sys/fs/cgroup/$c/cgroup.subtree_control)"
  done; journalctl -b --no-pager | grep -i -E "controller|cgroup" | head -10' 2>/dev/null || true
  exit 1
}
# Runs a command on the node. docker exec starts it in the root of the
# container's cgroup namespace, which, unlike a host's root, may hold no
# processes while systemd enables controllers below it: it moves into a
# cgroup of its own first.
in_node() {
  docker exec "${NAME}" sh -c \
    'mkdir -p /sys/fs/cgroup/exec && echo $$ >/sys/fs/cgroup/exec/cgroup.procs && exec "$@"' \
    sh "$@"
}
# Whether the input has a match. Unlike grep -q, it reads all of the
# input: a writer whose pipe closes early fails, and with it, under
# pipefail, the pipeline.
contains() { grep "$@" >/dev/null; }
export -f in_node contains
export NAME
# Waits until the command succeeds.
await() {
  local what="$1"
  shift
  for _ in $(seq $((TIMEOUT * 2))); do
    "$@" >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  fail "${what}"
}

shopt -s nullglob
debs=("${PACKAGES_DIR}"/*.deb)
[ ${#debs[@]} -ge 7 ] || { log "missing packages; run make packages"; exit 1; }

log "building ${IMAGE}: ${BASE} with systemd"
docker build -q -t "${IMAGE}" - >/dev/null <<EOF
FROM ${BASE}
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv \
      iproute2 nftables conntrack ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
EOF

cleanup() { docker rm -f -v "${NAME}" >/dev/null 2>&1 || true; }
trap cleanup EXIT
cleanup
# /var/lib/feos is a volume: on a distribution it is on disk.
docker run -d --name "${NAME}" --privileged --cgroupns=private \
  --tmpfs /run --tmpfs /run/lock -v /var/lib/feos -v /dev:/dev "${IMAGE}" >/dev/null
# Some units fail in a container: degraded is up, too.
await "systemd did not come up" bash -c \
  "in_node systemctl is-system-running --wait | contains -E '^(running|degraded)'"

log "installing ${debs[*]##*/}"
docker cp "${PACKAGES_DIR}/." "${NAME}:/opt/packages/"
in_node sh -c 'dpkg -i /opt/packages/*.deb' >/dev/null
# Type=notify: active once diskd serves, and once feosd's listeners are
# bound.
await "diskd is not active" in_node systemctl is-active diskd
await "feosd is not active" in_node systemctl is-active feosd
in_node feosctl host version-info | contains "FeOS Version" || fail "no version"
log "feosd is active and answers on its socket"

[ "$(in_node stat -c '%G %a' /run/feos/api.sock)" = "feos 660" ] ||
  fail "the API socket is not the group feos's"
in_node useradd -m -G feos tester
in_node su tester -c 'feosctl host hostname' >/dev/null || fail "a member of feos cannot use the API"
log "the group feos may use the API socket"

# Without --pod-prefix, a pod with a network fails, and says why.
out="$(in_node feosctl pod create --memory 256 2>&1)" &&
  fail "a pod with a network was created without --pod-prefix"
contains -e "--pod-prefix" <<<"${out}" || fail "no word of --pod-prefix: ${out}"
# The pods' network (ADR 0010) as in a lab: a ULA prefix, and a denied
# prefix.
in_node sh -c 'printf "%s\n" "FEOSD_ARGS=\"--pod-prefix fd00:fe05:1::/64 --deny-prefix 9.9.9.9/32\"" >/etc/default/feosd'
in_node systemctl restart feosd
await "feosd is not active with its network" in_node systemctl is-active feosd
log "pods with a network need --pod-prefix, which /etc/default/feosd gives"

leaf="$(in_node sh -c 'cat /proc/$(systemctl show -P MainPID feosd)/cgroup')"
[ "${leaf}" = "0::/system.slice/feosd.service/feosd" ] || fail "feosd runs in ${leaf}"

# A pod without containers: the installed guest in the installed
# Firecracker.
bare=11111111-2222-3333-4444-555555555555
microvm_pid() { in_node feosctl pod get "$1" | sed -n 's/^  MicroVM: pid \([0-9]*\),.*/\1/p'; }
export -f microvm_pid
in_node feosctl pod create --pod-id "${bare}" --memory 256 --wait >/dev/null ||
  fail "no pod from the installed guest"
pid="$(microvm_pid "${bare}")"
vms=/sys/fs/cgroup/system.slice/feos-vms.service/vms
in_node grep -qx "${pid}" "${vms}/${bare}/cgroup.procs" ||
  fail "Firecracker (pid ${pid}) is not in the pod's cgroup"
in_node grep -q '"firecracker":"/usr/lib/feos/firecracker/' \
  "/var/lib/feos/vms/firecracker/${bare}/jail.json" || fail "the pod does not run the installed Firecracker"
in_node test -b "/var/lib/feos/disk/live/${bare}/disk" || fail "the pod has no disk from diskd"
in_node grep -qE "cpu|memory" /sys/fs/cgroup/system.slice/feosd.service/cgroup.subtree_control &&
  fail "feosd.service's cgroup has controllers on for its children"
log "a pod boots the installed guest on a disk from diskd, in system.slice/feos-vms.service/vms/${bare}"

in_node systemctl restart feosd
await "feosd did not come back" in_node systemctl is-active feosd
in_node test -d "/proc/${pid}" || fail "the restart ended the pod's microVM"
await "the restarted feosd does not take the pod over" bash -c \
  "[ \"\$(microvm_pid ${bare})\" = ${pid} ]"
in_node feosctl pod get "${bare}" | contains "State: RUNNING" || fail "the pod is not running"
log "the pod outlived a restart of feosd, which took it over"

# A feosd from before --vms-cgroup put its VMs below its own cgroup and
# turned cpu and memory on there, so that systemd 258 and later could not
# start it again. A restart hands them over to feos-vms.service
# (ExecStopPost=) and starts feosd.
unit=/sys/fs/cgroup/system.slice/feosd.service
in_node sh -c "mkdir -p ${unit}/vms/legacy && echo '+cpu +memory' >${unit}/cgroup.subtree_control &&
  echo '+cpu +memory' >${unit}/vms/cgroup.subtree_control && echo 300 >${unit}/vms/legacy/cpu.weight"
docker exec -d "${NAME}" sh -c "echo \$\$ >${unit}/vms/legacy/cgroup.procs && exec sleep 600"
await "no process in the old VM cgroup" in_node grep -q . "${unit}/vms/legacy/cgroup.procs"
legacy="$(in_node cat "${unit}/vms/legacy/cgroup.procs")"
in_node systemctl restart feosd ||
  fail "feosd does not restart with VMs in its own cgroup"
await "feosd did not come back" in_node systemctl is-active feosd
in_node grep -qx "${legacy}" "${vms}/legacy/cgroup.procs" ||
  fail "the old VM (pid ${legacy}) is not in feos-vms.service: $(in_node cat /proc/"${legacy}"/cgroup)"
[ "$(in_node cat "${vms}/legacy/cpu.weight")" = 300 ] || fail "the old VM lost its cpu.weight"
in_node test ! -e "${unit}/vms" || fail "feosd.service still has vms/"
in_node grep -qE "cpu|memory" "${unit}/cgroup.subtree_control" &&
  fail "feosd.service's cgroup has controllers on for its children after the hand-over"
in_node sh -c "kill ${legacy}"
await "the old VM's process did not end" in_node sh -c "! grep -q . ${vms}/legacy/cgroup.procs"
in_node rmdir "${vms}/legacy"
in_node grep -qx "${pid}" "${vms}/${bare}/cgroup.procs" || fail "the pod left its cgroup"
in_node systemctl restart feosd
await "feosd did not come back" in_node systemctl is-active feosd
log "a restart hands the VMs of a feosd from before over to feos-vms.service, with their cpu.weight"

if in_node feosctl host upgrade http://127.0.0.1/feosd 2>/tmp/upgrade.err; then
  fail "feosd took an upgrade without --self-upgrade"
fi
log "feosd refuses to replace its own binary"

# With every package installed as a dependency, autoremove would take all
# of them but the versions of Firecracker and the guest.
in_node apt-mark auto feosd feosctl diskd feos-firecracker feos-guest \
  "$(in_node dpkg-query -W -f '${Package}\n' 'feos-firecracker-*')" \
  "$(in_node dpkg-query -W -f '${Package}\n' 'feos-guest-*')" >/dev/null
removed="$(in_node apt-get -s autoremove | sed -n 's/^Remv \([^ ]*\).*/\1/p' | sort | tr '\n' ' ')"
in_node apt-mark manual feosd feosctl >/dev/null
[ "${removed}" = "diskd feos-firecracker feos-guest feosctl feosd " ] ||
  fail "autoremove would remove ${removed}"
log "autoremove keeps the versions of Firecracker and the guest"

pod_state() { in_node feosctl pod get "${1:-${pod}}" | sed -n 's/^  State: //p'; }
pod_address() { in_node feosctl pod get "$1" | sed -n 's/^  IPv6 address: //p'; }
pod_ipv4() { in_node feosctl pod get "$1" | sed -n 's/^  IPv4 address: //p'; }
bare_ipv4="$(pod_ipv4 "${bare}")"
in_node feosctl pod delete "${bare}" >/dev/null
in_node test ! -e "${vms}/${bare}" ||
  fail "the pod's cgroup outlived it"
in_node grep -q "^freed ${bare_ipv4} " /var/lib/feos/pods/ipv4-addresses ||
  fail "the deleted pod's ${bare_ipv4} is not free: $(in_node cat /var/lib/feos/pods/ipv4-addresses)"

# Pods on feosd's network (ADR 0010, 0012, 0013). The pod pulls its image
# through the network, over IPv4.
pod=22222222-3333-4444-5555-666666666666
client=33333333-3333-4444-5555-666666666666
server=44444444-3333-4444-5555-666666666666
in_pod() { in_node feosctl container --pod "${pod}" exec main -- "$@"; }
in_client() { in_node feosctl container --pod "${client}" exec main -- "$@"; }
# The records of everything below.
in_node sh -c 'timeout 900 feosctl traffic watch >/tmp/traffic.log 2>&1 &'
in_node feosctl pod create --pod-id "${pod}" --image docker.io/library/busybox:1.36 --wait \
  -- sleep 3600 >/dev/null || fail "pod ${pod} did not come up: $(in_node feosctl pod get "${pod}")"
in_node feosctl pod get "${pod}" | contains "main (docker.io/library/busybox:1.36): running" ||
  fail "the pod's container does not run"
[ "$(in_pod echo forwarded)" = forwarded ] || fail "no exec in the pod through feosd"
in_node feosctl image --pod "${pod}" list | contains busybox || fail "the pod's images are not listed"
if in_node feosctl container exec main -- true 2>/dev/null; then
  fail "a call without the pod reached the pod"
fi
log "a pod pulled its image and runs; feosd forwards its services"

# Both families: an address of the prefix and one of 169.254.16.0/20,
# each routed to the pod's TAP device, which holds the resolver's address
# alone; the node answers ARP for the pod's gateway 169.254.0.1 by proxy.
address="$(pod_address "${pod}")"
pod_ipv4="$(pod_ipv4 "${pod}")"
case "${address}" in fd00:fe05:1:*) ;; *) fail "pod ${pod} has the address ${address}" ;; esac
case "${pod_ipv4}" in 169.254.1[6-9].* | 169.254.2[0-9].* | 169.254.3[01].*) ;;
  *) fail "pod ${pod} has the IPv4 address ${pod_ipv4}" ;; esac
[ "${pod_ipv4}" != "${bare_ipv4}" ] || fail "${bare_ipv4} came round before one never used"
in_pod ip -4 addr show dev eth0 | contains -F "inet ${pod_ipv4}/32" || fail "the pod has not ${pod_ipv4}/32"
in_pod ip -6 addr show dev eth0 | contains -F "inet6 ${address}/128" || fail "the pod has not ${address}/128"
in_pod ip -4 route show default | contains -F "default via 169.254.0.1 dev eth0" ||
  fail "the pod's IPv4 gateway is not 169.254.0.1: $(in_pod ip -4 route)"
tap=pod-22222222
[ "$(in_node ip -4 -o addr show dev "${tap}" | awk '{print $4}')" = 169.254.0.53/32 ] ||
  fail "${tap} holds other IPv4 addresses than 169.254.0.53/32: $(in_node ip -4 addr show dev "${tap}")"
in_node ip neigh show proxy dev "${tap}" | contains -x "169.254.0.1 *proxy *" ||
  fail "no proxy ARP for 169.254.0.1 on ${tap}: $(in_node ip neigh show proxy)"
in_node ip route show "${pod_ipv4}" | contains "dev ${tap}" || fail "${pod_ipv4} is not routed to ${tap}"
in_node ip -6 route show "${address}" | contains "dev ${tap}" || fail "${address} is not routed to ${tap}"
in_node ip -4 addr show dev feos-dns | contains -F "inet 169.254.0.53/32" || fail "feos-dns does not hold 169.254.0.53"
in_node ip -4 addr | contains -F "169.254.0.1/" && fail "the node holds 169.254.0.1"
in_pod cat /etc/resolv.conf | contains -x "nameserver 169.254.0.53" ||
  fail "the pod does not ask feosd's resolver"
log "pod ${pod} has ${address} and ${pod_ipv4}, routed to ${tap}, behind 169.254.0.1 by proxy ARP"

# Real answers of both families, nothing synthesized; IPv4 leaves the
# node masqueraded: by name, by an IPv4 literal, and ICMP.
dns="$(in_pod nslookup dns.google)"
contains -F "8.8.8.8" <<<"${dns}" && contains -F "2001:4860:4860::8888" <<<"${dns}" ||
  fail "no real answers for dns.google: ${dns}"
contains -F "64:ff9b" <<<"${dns}" && fail "a synthesized answer: ${dns}"
in_pod ping -c 1 -W 5 1.1.1.1 >/dev/null || fail "the pod does not reach 1.1.1.1 over ICMP"
in_pod wget -q -O - http://example.com/ | contains "Example Domain" ||
  fail "busybox wget does not reach http://example.com/ by name"
log "the pod resolves through 169.254.0.53 and reaches the internet over IPv4"

# The node's ARP for a pod asks from its TAP's address, also where the
# node holds 169.254.169.254, as hosts with a metadata service of their
# own do: the pod's answers to that address would go to the microVM's
# MMDS, and the node would not reach the pod until the pod asked it.
in_node ip addr add 169.254.169.254/32 dev lo
in_node ip neigh flush dev "${tap}"
dns="$(in_pod nslookup dns.google 2>&1 || true)"
in_node ip addr del 169.254.169.254/32 dev lo
contains -F "8.8.8.8" <<<"${dns}" ||
  fail "no answer once the node had to ask for the pod with 169.254.169.254 on lo: ${dns}"
log "the node's ARP for the pod asks from 169.254.0.53, not a metadata service's address"

# A pod whose security groups the node does not have does not start.
in_node feosctl pod create --pod-id "${server}" --memory 256 --security-group server \
  --image docker.io/library/busybox:1.36 -- sh -c \
  'mkdir -p /www && echo hello >/www/index.html && httpd -p 8080 -h /www && httpd -p 9090 -h /www && exec sleep 3600' \
  >/dev/null
await "a pod without its group did not fail" bash -c "[ \"\$(in_node feosctl pod get ${server} | sed -n 's/^  State: //p')\" = FAILED ]"
in_node feosctl pod get "${server}" | contains "Reason: .*security groups server" ||
  fail "the pod does not say which group it lacks: $(in_node feosctl pod get "${server}")"
# IPv4 blocks count out: the pods pull their images over IPv4.
in_node feosctl security-group put server --allow 'ingress tcp 8080 from group client' \
  --allow 'egress any to ::/0' --allow 'egress any to 0.0.0.0/0' >/dev/null
in_node feosctl security-group put client --allow 'egress any to ::/0' \
  --allow 'egress any to 0.0.0.0/0' >/dev/null
in_node feosctl pod start --wait "${server}" >/dev/null || fail "pod ${server} did not start with its group"
in_node feosctl pod create --pod-id "${client}" --memory 256 --security-group client \
  --metadata role=client --image docker.io/curlimages/curl:8.11.1 --wait -- sleep 3600 >/dev/null ||
  fail "pod ${client} did not come up: $(in_node feosctl pod get "${client}")"
if in_node feosctl security-group delete server 2>/dev/null; then
  fail "a group a pod names was deleted"
fi
log "a pod starts once the node has its security groups, which stay while it names them"

# A connection that is dropped runs into nc's timeout of 3 s; one that
# gets through is refused at once, nothing listens on port 9.
dropped() {
  local start=${SECONDS}
  in_pod nc -w 3 "$1" "${2:-9}" </dev/null >/dev/null 2>&1 || true
  [ $((SECONDS - start)) -ge 2 ]
}
# What the check sees when nothing drops: the pod's own addresses refuse.
dropped "${address}" && fail "a refused connection looks dropped"
dropped "${pod_ipv4}" && fail "a refused connection over IPv4 looks dropped"
server_address="$(pod_address "${server}")"
server_ipv4="$(pod_ipv4 "${server}")"
client_address="$(pod_address "${client}")"
client_ipv4="$(pod_ipv4 "${client}")"
node_ipv4="$(in_node ip -4 -o addr show dev eth0 | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p')"
dropped "${server_address}" 8080 || fail "a pod reaches another pod over IPv6"
dropped "${server_ipv4}" 8080 || fail "a pod reaches another pod over IPv4"
for target in "169.254.0.53 9" "169.254.0.53 80" "169.254.0.1 53" "169.254.0.1 80" \
  "${node_ipv4} 22" "${node_ipv4} 9" "169.254.169.253 80" "169.254.170.2 80"; do
  # shellcheck disable=SC2086
  dropped ${target} || fail "a pod reaches ${target}"
done
log "pods reach neither each other nor the node, its gateway or other link-local addresses"

# The pod's metadata (ADR 0010): Firecracker answers 169.254.169.254 in
# the microVM's network device, with a session token first. busybox has
# no PUT: nc asks for the token.
pod_metadata() {
  in_pod sh -c 'printf "PUT /latest/api/token HTTP/1.1\r\nHost: 169.254.169.254\r\nX-metadata-token-ttl-seconds: 60\r\nContent-Length: 0\r\n\r\n" |
    nc -w 2 169.254.169.254 80 | tail -n 1 >/tmp/token &&
    wget -q -O - --header "X-metadata-token: $(cat /tmp/token)" "http://169.254.169.254/$1"' sh "$1"
}
client_metadata() {
  local token
  token="$(in_client curl -sS -m 5 -X PUT -H 'X-metadata-token-ttl-seconds: 60' \
    http://169.254.169.254/latest/api/token)" || return 1
  in_client curl -sS -m 5 -H "X-metadata-token: ${token}" "$@"
}
code="$(in_client curl -sS -m 5 -o /dev/null -w '%{http_code}' http://169.254.169.254/feos/pod-id || true)"
[ "${code}" = 401 ] || fail "the metadata service answered ${code} without a session token"
in_pod wget -q -O - http://169.254.169.254/feos/pod-id >/dev/null 2>&1 &&
  fail "busybox wget got the metadata without a session token"
[ "$(client_metadata http://169.254.169.254/feos/pod-id)" = "${client}" ] ||
  fail "the client's metadata has not its ID: $(client_metadata http://169.254.169.254/feos/pod-id)"
[ "$(client_metadata http://169.254.169.254/feos/ipv6)" = "${client_address}" ] ||
  fail "the client's metadata has not its IPv6 address"
[ "$(client_metadata http://169.254.169.254/feos/ipv4)" = "${client_ipv4}" ] ||
  fail "the client's metadata has not its IPv4 address"
[ "$(client_metadata http://169.254.169.254/metadata/role)" = client ] ||
  fail "the client's metadata has not the spec's"
json="$(client_metadata -H 'Accept: application/json' http://169.254.169.254/)"
contains -F '"metadata":{"role":"client"}' <<<"${json}" || fail "no metadata as JSON: ${json}"
[ "$(pod_metadata feos/pod-id)" = "${pod}" ] || fail "the pod's metadata has not its ID: $(pod_metadata feos/pod-id)"
[ -z "$(pod_metadata metadata)" ] || fail "the pod has metadata it was not given: $(pod_metadata metadata)"
log "the pods read their metadata at 169.254.169.254, with a session token alone"

# The client's group lets it reach the server on 8080 over IPv6, once it
# is a member; over IPv4 never.
in_client curl -sS -m 3 "http://[${server_address}]:8080/" >/dev/null 2>&1 &&
  fail "the client reaches the server before it is a member of client"
in_node feosctl security-group update client --from-version 1 --add "${client_address}" >/dev/null
[ "$(in_client curl -sS -m 5 "http://[${server_address}]:8080/")" = hello ] ||
  fail "a member of client does not reach the server on 8080"
in_client curl -sS -m 3 "http://[${server_address}]:9090/" >/dev/null 2>&1 &&
  fail "a member of client reaches the server on 9090"
in_client curl -sS -m 3 "http://${server_ipv4}:8080/" >/dev/null 2>&1 &&
  fail "a member of client reaches the server over IPv4"
dropped "${server_address}" 8080 || fail "a pod outside client reaches the server"
log "a security group lets one pod reach another on its port over IPv6, and nothing else"

[ "$(in_client curl -sS -m 10 -o /dev/null -w '%{http_code}' https://example.com/)" = 200 ] ||
  fail "the client does not reach https://example.com/"
code="$(in_client curl -sS -m 10 -o /dev/null -w '%{http_code}' http://1.1.1.1/ || true)"
case "${code}" in [1-5][0-9][0-9]) ;; *) fail "the client does not reach http://1.1.1.1/: ${code}" ;; esac
start=${SECONDS}
in_client curl -sS -m 3 -o /dev/null "http://9.9.9.9/" 2>/dev/null &&
  fail "a pod reaches a denied prefix"
[ $((SECONDS - start)) -ge 2 ] || fail "a denied prefix refuses rather than drops"
log "the client reaches the internet over IPv4, by name and by literal, but not a denied prefix"

table="$(in_node nft list table inet feos)"
for expected in "map pod-in" "map pod-out" "set deny4" "set deny6" "set internet4" \
  "set internet6" "set g-client" "chain out-pod-44444444" "chain in-pod-44444444" \
  "chain from-pods" "chain to-pods" "iifname vmap @pod-out" "oifname vmap @pod-in" \
  "fib saddr . iif oif missing" 'log prefix "copy" group 3' 'log prefix "no-rule" group 2' \
  "ct state established,related accept" "ip daddr @deny4" "ip daddr @internet4 return" \
  'ip daddr 169.254.0.53 udp dport 53 accept' 'ip daddr 169.254.0.53 tcp dport 53 accept' \
  'ip saddr 169.254.16.0/20 oifname != "pod-*" masquerade'; do
  contains -F "${expected}" <<<"${table}" || fail "the table has no ${expected}"
done
contains -F "tcp dport 8080 ip6 saddr @g-client return" <<<"${table}" ||
  fail "the server's chain does not return the client's port"
deny4="$(sed -n '/set deny4/,/}/p' <<<"${table}" | tr -s ' \n\t' ' ')"
for denied in 9.9.9.9 169.254.0.0/16 "${node_ipv4}"; do
  contains -F "${denied}" <<<"${deny4}" || fail "deny4 has no ${denied}: ${deny4}"
done
sleep 2
records="$(in_node cat /tmp/traffic.log)"
for expected in " ${pod} dns dns.google A NOERROR " " ${pod} dns dns.google AAAA NOERROR " \
  " ${pod} flow icmp ${pod_ipv4} > 1.1.1.1 " " ${pod} flow tcp ${pod_ipv4}:" \
  " ${client} flow tcp ${client_ipv4}:" " ${client} flow tcp [${client_address}]:" \
  " ${server} flow tcp [${client_address}]:" " ${client} name tls tcp ${client_ipv4}:" \
  " ${client} drop tcp ${client_ipv4}:" " ${client} drop tcp [${client_address}]:" \
  " denied-prefix" " no-rule"; do
  contains -F -e "${expected}" <<<"${records}" || fail "no record with '${expected}': ${records}"
done
contains -F "8.8.8.8" <<<"$(grep -F " ${pod} dns dns.google A NOERROR " <<<"${records}")" ||
  fail "no A record of dns.google: ${records}"
contains -F "2001:4860:4860::8888" <<<"$(grep -F " ${pod} dns dns.google AAAA NOERROR " <<<"${records}")" ||
  fail "no AAAA record of dns.google: ${records}"
contains -F "> 9.9.9.9:80 out denied-prefix" <<<"$(grep -F " ${client} drop tcp " <<<"${records}")" ||
  fail "no drop of the denied prefix: ${records}"
contains -F "example.com" <<<"$(grep -F " name tls " <<<"${records}")" ||
  fail "no TLS server name example.com: ${records}"
grep -F " flow " <<<"${records}" | contains -F "169.254.0.53:53" &&
  fail "a query to the resolver is recorded as a flow: ${records}"
contains -F "169.254.169.254" <<<"${records}" &&
  fail "a packet to the metadata service reached the node: ${records}"
log "nftables has the pods' sets, chains and masquerade; feosctl traffic watch shows DNS, flows of both families with the pods' own addresses, drops and server names"

# Deleting a pod deletes its TAP device and the connections of its
# addresses; its IPv4 address comes round again only after the never used
# ones.
in_client curl -sS -m 10 -o /dev/null http://1.1.1.1/ || true
in_client curl -sS -m 5 -o /dev/null "http://[${server_address}]:8080/" || true
in_node conntrack -L -s "${client_ipv4}" 2>/dev/null | contains "src=${client_ipv4}" ||
  fail "no connections of ${client_ipv4} to be deleted"
in_node conntrack -L -f ipv6 -s "${client_address}" 2>/dev/null | contains "src=${client_address}" ||
  fail "no connections of ${client_address} to be deleted"
for id in "${client}" "${server}"; do
  in_node feosctl pod delete "${id}" >/dev/null
done
in_node feosctl security-group delete server >/dev/null || fail "an unused group stays"
in_node nft list table inet feos | contains "pod-44444444" && fail "a deleted pod's rules stay"
for tap in pod-33333333 pod-44444444; do
  in_node ip link show "${tap}" >/dev/null 2>&1 && fail "${tap} outlived its pod"
done
in_node ip neigh show proxy | contains -E "pod-(33333333|44444444)" && fail "a deleted pod's proxy entry stays"
in_node conntrack -L -s "${client_ipv4}" 2>/dev/null | contains "src=${client_ipv4}" &&
  fail "the deleted pod's connections stay: $(in_node conntrack -L -s "${client_ipv4}" 2>&1)"
in_node conntrack -L -f ipv6 -s "${client_address}" 2>/dev/null | contains "src=${client_address}" &&
  fail "the deleted pod's IPv6 connections stay: $(in_node conntrack -L -f ipv6 -s "${client_address}" 2>&1)"
next=55555555-3333-4444-5555-666666666666
in_node feosctl pod create --pod-id "${next}" --memory 256 --wait >/dev/null ||
  fail "pod ${next} did not come up: $(in_node feosctl pod get "${next}")"
next_ipv4="$(pod_ipv4 "${next}")"
for used in "${bare_ipv4}" "${pod_ipv4}" "${server_ipv4}" "${client_ipv4}"; do
  [ "${next_ipv4}" != "${used}" ] || fail "${used} came round before one never used"
done
in_node feosctl pod delete "${next}" >/dev/null
log "a deleted pod takes its TAP device and its connections; the next pod got ${next_ipv4}, never used"

in_node feosctl pod create --pod-id "${pod}" --image docker.io/library/busybox:1.36 \
  -- sleep 3600 >/dev/null ||
  fail "a create of the same pod again failed"
if in_node feosctl pod create --pod-id "${pod}" --image docker.io/library/alpine:3 >/dev/null 2>&1; then
  fail "a create of the pod with another spec went through"
fi

in_pod sh -c 'echo kept >/tmp/mark'
in_node feosctl pod suspend "${pod}" >/dev/null || fail "no suspend"
[ "$(pod_state)" = SUSPENDED ] || fail "the pod is $(pod_state), not suspended"
in_node feosctl pod resume "${pod}" >/dev/null || fail "no resume"
[ "$(in_pod cat /tmp/mark)" = kept ] || fail "the pod lost its memory in a suspend"
[ "$(pod_metadata feos/ipv6)" = "${address}" ] || fail "the pod lost its metadata in a suspend"
log "a pod suspends and resumes with its containers and its metadata"

in_node systemctl restart feosd
await "feosd did not come back" in_node systemctl is-active feosd
[ "$(pod_state)" = RUNNING ] || fail "after a restart of feosd, the pod is $(pod_state)"
[ "$(in_pod cat /tmp/mark)" = kept ] || fail "the pod did not outlive a restart of feosd"
[ "$(pod_address "${pod}")" = "${address}" ] && [ "$(pod_ipv4 "${pod}")" = "${pod_ipv4}" ] ||
  fail "the pod's addresses changed with a restart of feosd"
in_node ip neigh show proxy dev pod-22222222 | contains -F "169.254.0.1" ||
  fail "the pod's proxy ARP is gone with a restart of feosd"
in_pod wget -q -O - http://example.com/ | contains "Example Domain" ||
  fail "the pod lost its network with a restart of feosd"
[ "$(pod_metadata feos/pod-id)" = "${pod}" ] || fail "the pod lost its metadata with a restart of feosd"
log "the pod outlived a restart of feosd, with its network and its metadata"

# The resolver's sockets are feosd.socket's, which feosd takes and which
# outlive it (ADR 0010): a query while feosd is stopped waits in them,
# starts feosd, and is answered, not refused. feosctl reaches the pod
# through feosd: the pod puts its query off until feosd has stopped, and
# nothing but the query starts feosd again.
for proto in -u -t; do
  in_node ss -Hlnp "${proto}" src 169.254.0.53:53 | contains -F '"systemd"' ||
    fail "systemd does not hold the resolver's socket (ss ${proto})"
  in_node ss -Hlnp "${proto}" src 169.254.0.53:53 | contains -F '"feosd"' ||
    fail "feosd does not serve on systemd's socket (ss ${proto}): $(in_node ss -Hlnp "${proto}" src 169.254.0.53)"
done
in_pod sh -c 'setsid sh -c "sleep 8; nslookup dns.google >/tmp/stopped 2>&1" </dev/null >/dev/null 2>&1 &'
in_node systemctl stop feosd 2>/dev/null
in_node systemctl is-active feosd >/dev/null && fail "feosd did not stop"
in_node systemctl is-active feosd.socket >/dev/null || fail "feosd.socket stopped with feosd"
await "the pod's query did not start feosd" in_node systemctl is-active feosd
answered_while_stopped() { in_pod cat /tmp/stopped | contains -F "8.8.8.8"; }
await "no answer to the query while feosd was stopped" answered_while_stopped
in_node journalctl -u feosd --no-pager -n 300 |
  contains "The resolver takes the UDP socket handed to feosd" || fail "feosd bound a socket of its own"
log "the pods' resolver's sockets are feosd.socket's: a query while feosd is stopped starts it and is answered"

# The HTTP bindings' listeners are feosd-http.socket's, which feosd takes
# (ADR 0028); a pod without bindings is reset there.
for port in 80 443; do
  in_node ss -Hlnpt src "169.254.169.1:${port}" | contains -F '"feosd"' ||
    fail "feosd does not serve the HTTP bindings at port ${port}: $(in_node ss -Hlnpt src 169.254.169.1)"
done
in_node journalctl -u feosd --no-pager -n 300 |
  contains "Taking the listener at 169.254.169.1:80 handed to feosd" ||
  fail "feosd bound an HTTP bindings' listener of its own"
log "the HTTP bindings' listeners are feosd-http.socket's"

# The pod's disk outlives diskd: the next diskd takes its device over.
in_node systemctl restart diskd
await "diskd did not come back" in_node systemctl is-active diskd
in_pod sh -c 'echo kept >/on-disk && sync' || fail "the pod cannot write after a restart of diskd"
log "the pod's disk outlived a restart of diskd"

# Without an object store, which the package does not configure, a pod
# does not hibernate, and runs on.
out="$(in_node feosctl pod hibernate "${pod}" 2>&1)" &&
  fail "a pod hibernated without an object store"
contains "object store" <<<"${out}" || fail "no word of the object store: ${out}"
[ "$(pod_state)" = RUNNING ] || fail "a refused hibernation left the pod $(pod_state)"
[ "$(in_pod cat /tmp/mark)" = kept ] || fail "a refused hibernation reached the pod"
log "without an object store, a pod does not hibernate"

in_node feosctl pod stop "${pod}" >/dev/null || fail "no stop"
[ "$(pod_state)" = STOPPED ] || fail "the pod is $(pod_state), not stopped"
in_node feosctl pod start --wait "${pod}" >/dev/null || fail "the pod did not come up again"
[ "$(in_pod echo again)" = again ] || fail "no exec after a start"
[ "$(in_pod cat /on-disk)" = kept ] || fail "the pod lost what it wrote on its disk in a stop"
log "a stopped pod comes up again, on its disk"

in_node feosctl pod delete "${pod}" >/dev/null
in_node feosctl pod list | contains "${pod}" && fail "the pod outlived its delete"
in_node test -e "/var/lib/feos/vms/firecracker/${pod}" && fail "the pod's microVM outlived its delete"
log "a pod is deleted with its microVM"

in_node dpkg -r feosd >/dev/null
if in_node systemctl is-active feosd >/dev/null 2>&1; then fail "feosd runs after its removal"; fi
if in_node systemctl is-active feosd.socket >/dev/null 2>&1; then
  fail "feosd.socket is active after the removal"
fi
if in_node systemctl is-active feosd-http.socket >/dev/null 2>&1; then
  fail "feosd-http.socket is active after the removal"
fi
in_node sh -c 'dpkg -i /opt/packages/feosd_*.deb' >/dev/null
await "feosd is not active again" in_node systemctl is-active feosd
log "removing the package stops feosd, installing it starts it"

in_node feosctl host shutdown >/dev/null || true
for _ in $(seq $((TIMEOUT * 2))); do
  [ "$(docker inspect -f '{{.State.Running}}' "${NAME}")" = false ] && break
  sleep 0.5
done
[ "$(docker inspect -f '{{.State.Running}}' "${NAME}")" = false ] || fail "systemd did not power off"
log "Shutdown powers the node off through systemd"
log "PASS"
